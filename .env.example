# Copy to .env and edit. Never commit .env.
#   cp .env.example .env

# Local Docker defaults
PUBLIC_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Neon pooled connection URI used by the application.
DATABASE_URL=
# Neon direct connection URI used only for migrations.
DATABASE_URL_UNPOOLED=

# Neon private object storage (private uploads bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
STORAGE_BUCKET=uploads

POSTGRES_USER=autoscoring
POSTGRES_PASSWORD=autoscoring
POSTGRES_DB=autoscoring

SECRET_KEY=change-me-to-a-long-random-secret
SEED_DEMO_DATA=true
# Set true on hosts with no persistent local disk (Hugging Face Space, Render, ...).
REQUIRE_OBJECT_STORAGE=false
