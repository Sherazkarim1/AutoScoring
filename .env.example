# Copy to .env and edit. Never commit .env.
#   cp .env.example .env

# Local Docker defaults
PUBLIC_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

POSTGRES_USER=autoscoring
POSTGRES_PASSWORD=autoscoring
POSTGRES_DB=autoscoring

SECRET_KEY=change-me-to-a-long-random-secret

# Optional LLM for auto model answers / rubric / key concepts
# Groq (recommended free tier for FYP demos):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Or OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
